{
  "name": "reading-desk",
  "license": "MIT",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev:setup": "node scripts/dev-vault.mjs",
    "dev:open": "node scripts/open-dev-vault.mjs",
    "headless": "node scripts/headless.mjs",
    "worktree:setup": "pnpm install --frozen-lockfile && pnpm build && pnpm dev:setup",
    "worktree:start": "pnpm worktree:setup && pnpm dev:open",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
