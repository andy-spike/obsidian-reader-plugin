{
  "name": "reader-plugin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "dev:setup": "node scripts/dev-vault.mjs",
    "dev:open": "node scripts/open-dev-vault.mjs",
    "headless": "node scripts/headless.mjs",
    "worktree:setup": "pnpm install --frozen-lockfile && pnpm build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "pnpm build && node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-svelte": "^0.9.5",
    "obsidian": "^1.13.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
